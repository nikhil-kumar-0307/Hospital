@model Hospital.Models.DTOs.DoctorInShiftDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel">
    <div class="panel-header">ADD DOCTOR IN SHIFT</div>
    <div style="padding: 20px; max-width: 480px;">
        @using (Html.BeginForm("DoctorInShift", "Dashboard", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.DoctorId, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.DropDownListFor(m => m.DoctorId, Model.DoctorList, "-- Select Doctor --", new { style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.DoctorId, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.Shift, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.DropDownListFor(m => m.Shift, new SelectList(new[] { "MORNING", "EVENING", "NIGHT" }), "-- Select Shift --", new { style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.Shift, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.ShiftDate, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.TextBoxFor(m => m.ShiftDate, "{0:yyyy-MM-dd}", new { type = "date", style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.ShiftDate, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <button type="submit" style="background:#1f6fb2; color:#fff; border:none; padding:10px 22px; font-weight:700; border-radius:4px; cursor:pointer;">Save</button>
        }
    </div>
</div>

<div class="panel">
    <div class="panel-header">DOCTORS IN SHIFT</div>
    <table>
        <thead>
            <tr><th>SNo</th><th>Doctor's Name</th><th>Specialist</th><th>Shift</th></tr>
        </thead>
        <tbody>
            @{
                var shiftList = ViewBag.ShiftList as System.Collections.Generic.List<Hospital.Models.DoctorInShift>;
                int sNo = 1;
            }
            @if (shiftList != null && shiftList.Count > 0)
            {
                foreach (var item in shiftList)
                {
                    <tr>
                        <td>@sNo</td>
                        <td>@item.Doctor.Name</td>
                        <td>@item.Doctor.Specialist</td>
                        <td>@item.Shift</td>
                    </tr>
                    sNo++;
                }
            }
            else
            {
                <tr><td colspan="4" class="no-data">No doctors in shift</td></tr>
            }
        </tbody>
    </table>
</div>