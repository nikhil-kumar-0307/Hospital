@model Hospital.Models.DTOs.DoctorInShiftDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cancelUrl = Url.Action("DoctorInShift", "Dashboard");
    var pageTitle = Model.Id > 0 ? "EDIT DOCTOR IN SHIFT" : "ADD DOCTOR IN SHIFT";
    var buttonText = Model.Id > 0 ? "Update" : "Save";
}
<div class="panel">
    <div class="panel-header">@pageTitle</div>
    <div style="padding: 20px; max-width: 480px;">
        @if (TempData["Success"] != null)
        {
            <div style="background:#e6f7ea; color:#1e9e4e; border:1px solid #b8e6c4; padding:8px 12px; border-radius:4px; font-size:13px; margin-bottom:14px;">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div style="background:#fdeaea; color:#d92b2b; border:1px solid #f3c1c1; padding:8px 12px; border-radius:4px; font-size:13px; margin-bottom:14px;">
                @TempData["Error"]
            </div>
        }
        @using (Html.BeginForm("DoctorInShift", "Dashboard", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.DoctorId, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.DropDownListFor(m => m.DoctorId, Model.DoctorList, "-- Select Doctor --", new { style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.DoctorId, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.Shift, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.DropDownListFor(m => m.Shift, new SelectList(new[] { "MORNING", "EVENING", "NIGHT" }, Model.Shift), "-- Select Shift --", new { style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.Shift, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.ShiftDate, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.TextBoxFor(m => m.ShiftDate, "{0:yyyy-MM-dd}", new { type = "date", style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.ShiftDate, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <button type="submit" style="background:#1f6fb2; color:#fff; border:none; padding:10px 22px; font-weight:700; border-radius:4px; cursor:pointer;">@buttonText</button>
            if (Model.Id > 0)
            {
                <a href="@cancelUrl" style="margin-left:10px; color:#666; text-decoration:none; font-size:13px;">Cancel</a>
            }
        }
    </div>
</div>
<div class="panel">
    <div class="panel-header">DOCTORS IN SHIFT</div>
    <table>
        <thead>
            <tr><th>SNo</th><th>Doctor's Name</th><th>Specialist</th><th>Shift</th><th>Date</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @{
                var shiftList = ViewBag.ShiftList as System.Collections.Generic.List<Hospital.Models.DoctorInShift>;
                int sNo = 1;
            }
            @if (shiftList != null && shiftList.Count > 0)
            {
                foreach (var item in shiftList)
                {
                    var editUrl = Url.Action("DoctorInShift", "Dashboard", new { id = item.Id });
                    var confirmMsg = "Delete this shift record for " + item.Doctor.Name.Replace("'", "\\'") + "?";
                    <tr>
                        <td>@sNo</td>
                        <td>@item.Doctor.Name</td>
                        <td>@item.Doctor.Specialist</td>
                        <td>@item.Shift</td>
                        <td>@item.ShiftDate.ToString("dd-MM-yyyy")</td>
                        <td>
                            <a href="@editUrl" style="color:#1f6fb2; text-decoration:none; font-size:12px; margin-right:10px;">Edit</a>
                            @using (Html.BeginForm("DeleteDoctorInShift", "Dashboard", new { id = item.Id }, FormMethod.Post, new { style = "display:inline;", onsubmit = "return confirm('" + confirmMsg + "');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" style="background:none; border:none; color:#d92b2b; cursor:pointer; font-size:12px; padding:0;">Delete</button>
                            }
                        </td>
                    </tr>
                    sNo++;
                }
            }
            else
            {
                <tr><td colspan="6" class="no-data">No doctors in shift</td></tr>
            }
        </tbody>
    </table>
</div>