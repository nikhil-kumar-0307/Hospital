@model Hospital.Models.DTOs.DoctorTelemedicineDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cancelUrl = Url.Action("DoctorInTelemedicine", "Dashboard");
    var pageTitle = Model.Id > 0 ? "EDIT DOCTOR IN TELEMEDICINE" : "ADD DOCTOR IN TELEMEDICINE";
    var buttonText = Model.Id > 0 ? "Update" : "Save";
}

<div class="panel">
    <div class="panel-header">@pageTitle</div>
    <div style="padding: 20px; max-width: 480px;">
        @if (TempData["Success"] != null)
        {
            <div style="background:#e6f7ea; color:#1e9e4e; border:1px solid #b8e6c4; padding:8px 12px; border-radius:4px; font-size:13px; margin-bottom:14px;">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div style="background:#fdeaea; color:#d92b2b; border:1px solid #f3c1c1; padding:8px 12px; border-radius:4px; font-size:13px; margin-bottom:14px;">
                @TempData["Error"]
            </div>
        }
        @using (Html.BeginForm("DoctorInTelemedicine", "Dashboard", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.DoctorName, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.TextBoxFor(m => m.DoctorName, new { style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;", placeholder = "e.g. Dr. Abhishek Sing (Medanta Hospital) (11:30am to 12:30pm)" })
                @Html.ValidationMessageFor(m => m.DoctorName, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.Specialist, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.TextBoxFor(m => m.Specialist, new { style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;", placeholder = "e.g. Cardiology" })
                @Html.ValidationMessageFor(m => m.Specialist, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.RoomNo, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.TextBoxFor(m => m.RoomNo, new { style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;", placeholder = "e.g. 23" })
                @Html.ValidationMessageFor(m => m.RoomNo, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.SessionDate, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.TextBoxFor(m => m.SessionDate, "{0:yyyy-MM-dd}", new { type = "date", style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.SessionDate, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px; display:flex; gap: 24px;">
                <label style="font-size:13px; display:flex; align-items:center; gap:6px;">
                    @Html.CheckBoxFor(m => m.Forenoon) Forenoon
                </label>
                <label style="font-size:13px; display:flex; align-items:center; gap:6px;">
                    @Html.CheckBoxFor(m => m.Afternoon) Afternoon
                </label>
            </div>
            <button type="submit" style="background:#1f6fb2; color:#fff; border:none; padding:10px 22px; font-weight:700; border-radius:4px; cursor:pointer;">@buttonText</button>
            if (Model.Id > 0)
            {
                <a href="@cancelUrl" style="margin-left:10px; color:#666; text-decoration:none; font-size:13px;">Cancel</a>
            }
        }
    </div>
</div>

<div class="panel">
    <div class="panel-header">DOCTORS IN TELEMEDICINE</div>
    <table>
        <thead>
            <tr><th>SNo</th><th>Doctor's Name</th><th>Specialist</th><th>Room No</th><th>F/N</th><th>A/N</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @{
                var telemedicineList = ViewBag.TelemedicineList as System.Collections.Generic.List<Hospital.Models.DoctorTelemedicine>;
                int sNo = 1;
            }
            @if (telemedicineList != null && telemedicineList.Count > 0)
            {
                foreach (var item in telemedicineList)
                {
                    var editUrl = Url.Action("DoctorInTelemedicine", "Dashboard", new { id = item.Id });
                    var confirmMsg = "Delete telemedicine record for " + item.DoctorName.Replace("'", "\\'") + "?";
                    <tr>
                        <td>@sNo</td>
                        <td>@item.DoctorName</td>
                        <td>@item.Specialist</td>
                        <td>@item.RoomNo</td>
                        <td>@Html.Raw(item.Forenoon ? "<span class='icon-yes'>&#10004;</span>" : "<span class='icon-no'>&#10006;</span>")</td>
                        <td>@Html.Raw(item.Afternoon ? "<span class='icon-yes'>&#10004;</span>" : "<span class='icon-no'>&#10006;</span>")</td>
                        <td>
                            <a href="@editUrl" style="color:#1f6fb2; text-decoration:none; font-size:12px; margin-right:10px;">Edit</a>
                            @using (Html.BeginForm("DeleteDoctorInTelemedicine", "Dashboard", new { id = item.Id }, FormMethod.Post, new { style = "display:inline;", onsubmit = "return confirm('" + confirmMsg + "');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" style="background:none; border:none; color:#d92b2b; cursor:pointer; font-size:12px; padding:0;">Delete</button>
                            }
                        </td>
                    </tr>
                    sNo++;
                }
            }
            else
            {
                <tr><td colspan="7" class="no-data">No telemedicine doctors found</td></tr>
            }
        </tbody>
    </table>
</div>