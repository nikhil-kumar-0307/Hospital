@model Hospital.Models.DTOs.DoctorOnLeaveDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel">
    <div class="panel-header">MARK DOCTOR ON LEAVE</div>
    <div style="padding: 20px; max-width: 480px;">
        @using (Html.BeginForm("DoctorsOnLeave", "Dashboard", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.DoctorId, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.DropDownListFor(m => m.DoctorId, Model.DoctorList, "-- Select Doctor --", new { style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.DoctorId, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.FromDate, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.TextBoxFor(m => m.FromDate, "{0:yyyy-MM-dd}", new { type = "date", style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.FromDate, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.ToDate, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.TextBoxFor(m => m.ToDate, "{0:yyyy-MM-dd}", new { type = "date", style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.ToDate, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <button type="submit" style="background:#1f6fb2; color:#fff; border:none; padding:10px 22px; font-weight:700; border-radius:4px; cursor:pointer;">Save Leave</button>
        }
    </div>
</div>

<div class="panel">
    <div class="panel-header">DOCTORS ON LEAVE</div>
    <table>
        <thead>
            <tr><th>SNo</th><th>Doctor's Name</th><th>Specialist</th><th>From Date To Date</th></tr>
        </thead>
        <tbody>
            @{
                var leaveList = ViewBag.LeaveList as System.Collections.Generic.List<Hospital.Models.DoctorOnLeave>;
                int sNo = 1;
            }
            @if (leaveList != null && leaveList.Count > 0)
            {
                foreach (var item in leaveList)
                {
                    <tr>
                        <td>@sNo</td>
                        <td class="doc-name">@item.Doctor.Name</td>
                        <td class="specialist">@item.Doctor.Specialist</td>
                        <td>@item.FromDate.ToString("dd-MM-yyyy") - @item.ToDate.ToString("dd-MM-yyyy")</td>
                    </tr>
                    sNo++;
                }
            }
            else
            {
                <tr><td colspan="4" class="no-data">No doctors on leave</td></tr>
            }
        </tbody>
    </table>
</div>