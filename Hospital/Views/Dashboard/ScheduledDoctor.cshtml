@model Hospital.Models.DTOs.ScheduledDoctorDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cancelUrl = Url.Action("ScheduledDoctor", "Dashboard");
    var pageTitle = Model.Id > 0 ? "EDIT SCHEDULED DOCTOR" : "SCHEDULE A DOCTOR";
    var buttonText = Model.Id > 0 ? "Update Schedule" : "Save Schedule";
}
<div class="panel">
    <div class="panel-header">@pageTitle</div>
    <div style="padding: 20px; max-width: 480px;">
        @if (TempData["Success"] != null)
        {
            <div style="background:#e6f7ea; color:#1e9e4e; border:1px solid #b8e6c4; padding:8px 12px; border-radius:4px; font-size:13px; margin-bottom:14px;">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div style="background:#fdeaea; color:#d92b2b; border:1px solid #f3c1c1; padding:8px 12px; border-radius:4px; font-size:13px; margin-bottom:14px;">
                @TempData["Error"]
            </div>
        }
        @using (Html.BeginForm("ScheduledDoctor", "Dashboard", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.DoctorId, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.DropDownListFor(m => m.DoctorId, Model.DoctorList, "-- Select Doctor --", new { style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.DoctorId, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.ScheduledDate, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.TextBoxFor(m => m.ScheduledDate, "{0:yyyy-MM-dd}", new { type = "date", style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;" })
                @Html.ValidationMessageFor(m => m.ScheduledDate, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px;">
                @Html.LabelFor(m => m.RoomNo, new { style = "display:block; font-size:13px; font-weight:600; margin-bottom:5px;" })
                @Html.TextBoxFor(m => m.RoomNo, new { style = "width:100%; padding:9px 10px; border:1px solid #ccd4dc; border-radius:4px;", placeholder = "e.g. 21" })
                @Html.ValidationMessageFor(m => m.RoomNo, "", new { style = "color:#d92b2b; font-size:12px;" })
            </div>
            <div style="margin-bottom: 14px; display:flex; gap: 24px;">
                <label style="font-size:13px; display:flex; align-items:center; gap:6px;">
                    @Html.CheckBoxFor(m => m.Forenoon) Forenoon
                </label>
                <label style="font-size:13px; display:flex; align-items:center; gap:6px;">
                    @Html.CheckBoxFor(m => m.Afternoon) Afternoon
                </label>
            </div>
            <button type="submit" style="background:#1f6fb2; color:#fff; border:none; padding:10px 22px; font-weight:700; border-radius:4px; cursor:pointer;">@buttonText</button>
            if (Model.Id > 0)
            {
                <a href="@cancelUrl" style="margin-left:10px; color:#666; text-decoration:none; font-size:13px;">Cancel</a>
            }
        }
    </div>
</div>
<div class="panel">
    <div class="panel-header">SCHEDULED DOCTORS</div>
    <table>
        <colgroup>
            <col style="width:6%;" />
            <col style="width:18%;" />
            <col style="width:15%;" />
            <col style="width:10%;" />
            <col style="width:13%;" />
            <col style="width:9%;" />
            <col style="width:9%;" />
            <col style="width:20%;" />
        </colgroup>
        <thead>
            <tr>
                <th>SNo</th>
                <th>Doctor's Name</th>
                <th>Specialist</th>
                <th>Room No</th>
                <th>Date</th>
                <th>F/N</th>
                <th>A/N</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                var scheduledList = ViewBag.ScheduledList as System.Collections.Generic.List<Hospital.Models.ScheduledDoctor>;
                int sNo = 1;
            }
            @if (scheduledList != null && scheduledList.Count > 0)
            {
                foreach (var item in scheduledList)
                {
                    var editUrl = Url.Action("ScheduledDoctor", "Dashboard", new { id = item.Id });
                    var confirmMsg = "Delete this scheduled record for " + item.Doctor.Name.Replace("'", "\\'") + "?";
                    <tr>
                        <td>@sNo</td>
                        <td>@item.Doctor.Name</td>
                        <td>@item.Doctor.Specialist</td>
                        <td>@item.RoomNo</td>
                        <td>@item.ScheduledDate.ToString("dd-MM-yyyy")</td>
                        <td>@Html.Raw(item.Forenoon ? "<span class='icon-yes'>&#10004;</span>" : "<span class='icon-no'>&#10006;</span>")</td>
                        <td>@Html.Raw(item.Afternoon ? "<span class='icon-yes'>&#10004;</span>" : "<span class='icon-no'>&#10006;</span>")</td>
                        <td>
                            <a href="@editUrl" style="color:#1f6fb2; text-decoration:none; font-size:12px; margin-right:10px;">Edit</a>
                            @using (Html.BeginForm("DeleteScheduledDoctor", "Dashboard", new { id = item.Id }, FormMethod.Post, new { style = "display:inline;", onsubmit = "return confirm('" + confirmMsg + "');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" style="background:none; border:none; color:#d92b2b; cursor:pointer; font-size:12px; padding:0;">Delete</button>
                            }
                        </td>
                    </tr>
                    sNo++;
                }
            }
            else
            {
                <tr><td colspan="8" class="no-data">No scheduled doctors found</td></tr>
            }
        </tbody>
    </table>
</div>