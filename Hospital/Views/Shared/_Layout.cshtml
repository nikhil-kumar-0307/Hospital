<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Hospital Portal</title>
    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            height: 100%;
            font-family: Segoe UI, Arial, sans-serif;
            background: #eef1f4;
            color: #223;
        }

        /* TOP HEADER */
        .header {
            background: #0b2e5e;
            color: #fff;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 10;
        }

            .header .logo-box img {
                height: 48px;
                background: #fff;
                border-radius: 4px;
                padding: 4px 8px;
            }

            .header .title-block {
                text-align: center;
                flex: 1;
            }

                .header .title-block h1 {
                    margin: 0;
                    font-size: 22px;
                    letter-spacing: 1px;
                }

                .header .title-block .page-date {
                    margin-top: 2px;
                    font-size: 13px;
                    opacity: .9;
                }

            .header .right-block {
                display: flex;
                align-items: center;
                gap: 14px;
            }

                .header .right-block img {
                    height: 48px;
                    background: #fff;
                    border-radius: 4px;
                    padding: 4px 8px;
                }

        .user-chip {
            font-size: 13px;
            opacity: .9;
            font-family: 'IBM Plex Mono', monospace;
        }

        .btn-logout {
            background: #ffb703;
            color: #0b2e5e;
            border: none;
            padding: 8px 18px;
            font-weight: 700;
            border-radius: 4px;
            cursor: pointer;
            font-size: 13px;
        }

            .btn-logout:hover {
                background: #ffc93c;
            }

        /* LAYOUT SHELL */
        .app-shell {
            display: flex;
            min-height: calc(100vh - 72px);
        }

        /* SIDEBAR */
        .sidebar {
            width: 230px;
            background: #0f3868;
            color: #dce6f2;
            flex-shrink: 0;
            padding: 18px 0;
        }

            .sidebar .nav-section-label {
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .5px;
                color: #7f9cc0;
                padding: 6px 20px 10px;
            }

            .sidebar a {
                display: block;
                padding: 11px 20px;
                color: #dce6f2;
                text-decoration: none;
                font-size: 14px;
                border-left: 3px solid transparent;
            }

                .sidebar a:hover {
                    background: #164a8c;
                    color: #fff;
                }

                .sidebar a.active {
                    background: #1f6fb2;
                    color: #fff;
                    border-left: 3px solid #ffb703;
                    font-weight: 600;
                }

        /* MAIN CONTENT */
        .main-content {
            flex: 1;
            padding: 20px;
        }

        /* SHARED PANEL/TABLE STYLES (used across pages) */
        .panel {
            background: #fff;
            border: 1px solid #d7dee6;
            border-radius: 3px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .panel-header {
            background: #1f6fb2;
            color: #fff;
            font-weight: 700;
            font-size: 13px;
            letter-spacing: .5px;
            padding: 8px 14px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            font-size: 13px;
        }

        thead th {
            background: #f2f5f8;
            text-align: center;
            padding: 8px 6px;
            font-weight: 700;
            border: 1px solid #d7dee6;
            white-space: nowrap;
        }

        tbody td {
            text-align: center;
            padding: 8px 6px;
            border: 1px solid #eef2f6;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        tbody tr:nth-child(even) {
            background: #fafcfe;
        }

        .doc-name, .specialist {
            text-align: left;
        }

        .icon-yes {
            color: #1e9e4e;
            font-weight: 700;
        }

        .icon-no {
            color: #d92b2b;
            font-weight: 700;
        }

        .no-data {
            text-align: center;
            padding: 14px;
            color: #888;
            font-size: 13px;
        }

        footer {
            text-align: center;
            font-size: 12px;
            color: #667;
            padding: 16px;
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>

    <div class="header">
        <div class="logo-box">
            <img src="~/Content/images/ntpc-50-years-logo.png" alt="NTPC 50 Years" />
        </div>
        <div class="title-block">
            <h1>@ViewBag.Title</h1>
            <div class="page-date">@(ViewBag.PageDate ?? DateTime.Now.ToString("dd-MMM-yyyy"))</div>
        </div>
        <div class="right-block">
            <span class="user-chip">@User.Identity.Name</span>
            <img src="~/Content/images/kahalgaon-logo.png" alt="Kahalgaon" />
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
            {
                <button type="submit" class="btn-logout">Logout</button>
            }
        </div>
    </div>

    <div class="app-shell">

        <div class="sidebar">
            <div class="nav-section-label">Doctor Management</div>
            @{
                string currentAction = ViewContext.RouteData.Values["action"].ToString();
            }
            <a href="@Url.Action("Index", "Dashboard")" class="@(currentAction == "Index" ? "active" : "")">Dashboard</a>
            <a href="@Url.Action("AddDoctor", "Dashboard")" class="@(currentAction == "AddDoctor" ? "active" : "")">Add Doctor</a>
            <a href="@Url.Action("ScheduledDoctor", "Dashboard")" class="@(currentAction == "ScheduledDoctor" ? "active" : "")">Scheduled Doctor</a>
            <a href="@Url.Action("VisitingDoctor", "Dashboard")" class="@(currentAction == "VisitingDoctor" ? "active" : "")">Visiting Doctor</a>
            <a href="@Url.Action("DoctorInShift", "Dashboard")" class="@(currentAction == "DoctorInShift" ? "active" : "")">Doctor In Shift</a>
            <a href="@Url.Action("DoctorsOnLeave", "Dashboard")" class="@(currentAction == "DoctorsOnLeave" ? "active" : "")">Doctors on Leave</a>
            <a href="@Url.Action("DoctorInTelemedicine", "Dashboard")" class="@(currentAction == "DoctorInTelemedicine" ? "active" : "")">Doctors in Telemedicine</a>
        </div>

        <div class="main-content">
            @RenderBody()
        </div>

    </div>

    <footer>&copy; Copyright @DateTime.Now.Year NTPC Ltd. All Rights Reserved | Designed by IT Department Kahalgaon.</footer>

    @RenderSection("scripts", required: false)
</body>
</html>